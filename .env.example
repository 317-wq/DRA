# 开发用覆盖（普通使用者请运行 `dra init`，配置会写到系统配置目录）
# 优先级：环境变量 > 用户 config.toml > 本文件

DRA_API_KEY=
DRA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DRA_MODEL=qwen3.8-max
# 降级链：主模型不可用时按序切换（JSON 数组）
DRA_FALLBACK_MODELS=["deepseek-v4.1-flash"]
DRA_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
DRA_TAVILY_API_KEY=
DRA_DISABLE_THINKING=true

# 可选：把配置与数据放到指定位置（测试/多环境）
# DRA_CONFIG_FILE=./config.toml
# DRA_DATA_DIR=./data
# DRA_RUNS_DIR=./runs
