    F --> G[("runs/&lt;id&gt;/<br/>report.md · sources.json")]
    F -. 事件 .-> H["trace.jsonl"]
    C -. 配置优先级 .-> I["参数 &gt; 环境变量 &gt;<br/>config.toml &gt; .env"]
    style C fill:#1f2d3d,stroke:#3b82f6,color:#e4e9f0
    style D fill:#1f2d3d,stroke:#3b82f6,color:#e4e9f0
